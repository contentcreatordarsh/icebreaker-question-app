# Build-time (VITE_*) and local env vars. Copy to .env and fill in as needed.
# Everything here is OPTIONAL — the app runs fine with none of these set.

# ── Error monitoring (optional) ──────────────────────────────────────────────
# Sentry DSN for the frontend. Leave unset to disable (no-op).
VITE_SENTRY_DSN=""

# ── Ads — Google AdSense (optional; the app is free + ad-supported) ───────────
# Until BOTH of these are set, there are NO ads and NO cookie/consent banner —
# the app behaves exactly as it does today.
#   VITE_ADSENSE_CLIENT : your AdSense publisher ID, e.g. "ca-pub-1234567890123456"
#   VITE_ADSENSE_SLOT_HOME : the ad-unit "slot" ID for the home placement (from
#                            AdSense → Ads → By ad unit), e.g. "1234567890"
VITE_ADSENSE_CLIENT=""
VITE_ADSENSE_SLOT_HOME=""
