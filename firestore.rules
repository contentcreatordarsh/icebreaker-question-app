rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'darshan.p.hegde@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Validation ---
    // Uses hasAll() instead of size() == N so new fields can be added
    // without breaking client-side writes.
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'isPremium', 'subscriptionStatus',
          'lifetimePurchase', 'createdAt'
        ]) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.isPremium is bool &&
        data.subscriptionStatus in ['none', 'active', 'canceled', 'past_due'] &&
        data.lifetimePurchase is bool &&
        data.createdAt is timestamp;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['text', 'category']) &&
             data.text is string && data.text.size() <= 1000 &&
             data.category is string && data.category.size() <= 100;
    }

    // Validate shared collections to prevent oversized payloads or missing fields.
    function isValidSharedCollection(data) {
      return data.keys().hasAll(['ownerUid', 'title', 'questions', 'createdAt']) &&
             data.ownerUid is string && data.ownerUid.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.questions is list && data.questions.size() <= 100 &&
             data.createdAt is timestamp;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();

      // First-time profile creation
      allow create: if isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().isPremium == false &&
                       incoming().subscriptionStatus == 'none';

      // Client-side updates: ONLY truly safe, non-monetizable fields.
      // Usage/streak/bonus/referral counters and all premium fields
      // (usageCount, currentStreak, longestStreak, lastActiveDate,
      // referralCount, bonusQuestions, referredBy, isPremium,
      // subscriptionStatus, subscriptionPlan, lifetimePurchase,
      // stripeCustomerId) are written ONLY by the Worker via the service
      // account (which bypasses these rules). This prevents a client from
      // self-granting unlimited usage or bonus questions from the browser.
      allow update: if isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().isPremium == existing().isPremium &&
                       incoming().subscriptionStatus == existing().subscriptionStatus &&
                       incoming().lifetimePurchase == existing().lifetimePurchase &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'email', 'referralCode'
                       ]);

      // Admin can update anything
      allow update: if isAdmin();

      match /favorites/{questionId} {
        allow read, write: if isOwner(userId);
      }

      match /history/{questionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- Questions & Daily Questions ---
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin() && isValidQuestion(incoming());
    }

    match /daily_questions/{date} {
      allow read: if true;
      // Signed-in users may CREATE a new daily-question doc (client-side caching).
      // Only admins may UPDATE or DELETE existing docs (prevents content poisoning).
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Shared Collections (Phase 5) ---
    match /shared_collections/{shareId} {
      allow read: if true;
      // Enforce schema + ownership on create to prevent oversized payloads.
      allow create: if isSignedIn() &&
                       incoming().ownerUid == request.auth.uid &&
                       isValidSharedCollection(incoming());
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
